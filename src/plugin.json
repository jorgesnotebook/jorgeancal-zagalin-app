{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Zagalin",
  "id": "jorgeancal-zagalin-app",
  "backend": true,
  "executable": "gpx_zagalin",
  "info": {
    "keywords": ["ai", "llm", "chat", "assistant", "openai", "promql", "logql", "observability", "monitoring"],
    "description": "Zagalin - Context-aware AI assistant for Grafana. Chat with your metrics, generate queries, and troubleshoot issues using natural language powered by LLMs.",
    "author": {
      "name": "Jorge Andreu Calatayud",
      "url": "https://github.com/jorgeancal"
    },
    "logos": {
      "small": "img/logo.png",
      "large": "img/logo.png"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/jorgesnotebook/jorgeancal-zagalin-app"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/jorgesnotebook/jorgeancal-zagalin-app#readme"
      },
      {
        "name": "Report Issues",
        "url": "https://github.com/jorgesnotebook/jorgeancal-zagalin-app/issues"
      },
      {
        "name": "License",
        "url": "https://github.com/jorgesnotebook/jorgeancal-zagalin-app/blob/main/LICENSE"
      }
    ],
    "screenshots": [
      {
        "name": "Floating Chat Interface",
        "path": "img/screenshots/floating-chat.png"
      },
      {
        "name": "Dashboard Context Awareness",
        "path": "img/screenshots/dashboard-context.png"
      },
      {
        "name": "Natural Language Query Generation",
        "path": "img/screenshots/query-generation.png"
      },
      {
        "name": "Plugin Configuration",
        "path": "img/screenshots/configuration.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Chat",
      "path": "/a/%PLUGIN_ID%",
      "addToNav": true,
      "defaultNav": true,
      "role": "Viewer"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "plugins": [
      {
        "type": "app",
        "name": "LLM App",
        "id": "grafana-llm-app",
        "version": "1.0.0"
      }
    ]
  },
  "iam": {
    "permissions": [
      { "action": "plugins.app:access", "scope": "plugins:id:grafana-llm-app" },
      { "action": "datasources:read", "scope": "datasources:*" },
      { "action": "datasources:query", "scope": "datasources:*" },
      { "action": "datasources.id:read", "scope": "*" },
      { "action": "datasources.correlations:read", "scope": "*" },
      { "action": "dashboards:read", "scope": "dashboards:*" },
      { "action": "dashboards:write", "scope": "dashboards:*" },
      { "action": "dashboards:create", "scope": "folders:*" },
      { "action": "dashboards:delete", "scope": "dashboards:*" },
      { "action": "folders:read", "scope": "folders:*" },
      { "action": "folders:write", "scope": "folders:*" },
      { "action": "folders:create", "scope": "*" },
      { "action": "alert.rules:read", "scope": "folders:*" },
      { "action": "alert.rules:write", "scope": "folders:*" },
      { "action": "alert.rules:create", "scope": "folders:*" },
      { "action": "alert.rules:delete", "scope": "folders:*" },
      { "action": "alert.instances:read", "scope": "*" },
      { "action": "alert.notifications:read", "scope": "*" },
      { "action": "alert.notifications:write", "scope": "*" },
      { "action": "alert.silences:read", "scope": "*" },
      { "action": "alert.silences:write", "scope": "*" },
      { "action": "alert.silences:create", "scope": "*" },
      { "action": "alert.silences:delete", "scope": "*" },
      { "action": "annotations:read", "scope": "*" },
      { "action": "annotations:write", "scope": "*" },
      { "action": "annotations:delete", "scope": "*" },
      { "action": "library.panels:read", "scope": "*" },
      { "action": "library.panels:write", "scope": "*" },
      { "action": "library.panels:create", "scope": "*" },
      { "action": "library.panels:delete", "scope": "*" },
      { "action": "playlists:read", "scope": "*" },
      { "action": "playlists:write", "scope": "*" },
      { "action": "playlists:create", "scope": "*" },
      { "action": "playlists:delete", "scope": "*" },
      { "action": "org.users:read", "scope": "*" },
      { "action": "users:read", "scope": "*" },
      { "action": "teams:read", "scope": "*" }
    ]
  }
}
